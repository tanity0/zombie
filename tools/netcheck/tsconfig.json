{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["app.ts", "playwright.config.ts", "tests/**/*.e2e.ts", "../../src/online/**/*.ts"],
  "exclude": ["../../src/online/**/*.test.ts"]
}
